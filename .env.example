# Copier ce fichier sous le nom .env, puis renseigner la clé (gratuite : https://console.groq.com/keys).
# Sans clé, l'assistant RAG fonctionne en mode extractif (phrases des passages retrouvés).
GROQ_API_KEY=

# Facultatif : autre modèle Groq, autre port publié par Docker
# GROQ_MODELE=openai/gpt-oss-120b
# PORT=8000
